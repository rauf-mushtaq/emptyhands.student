{
  "name": "emptyhands-mobile",
  "private": true,
  "description": "App Store / Google Play builds of the EmptyHands student app (../index.html).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "sync": "node build.mjs && cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor '#f6f2ea' --iconBackgroundColorDark '#14120f' --splashBackgroundColor '#f6f2ea' --splashBackgroundColorDark '#14120f'",
    "android": "node build.mjs && cap sync android && cap open android",
    "ios": "node build.mjs && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  }
}
